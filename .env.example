# Copy to .env.local and fill in. Never commit real values.

# --- App ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32   (required; never reuse across environments)
NEXTAUTH_SECRET=
DATABASE_URL=file:./dev.db

# --- AI chat assistant (optional; without a key the rule-based parser is used) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Data sources ---
PRICE_PROVIDERS=mock

# --- Login (optional) ---
# Google sign-in appears only when both are set
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# One-time-code delivery. Only "mock" exists (development only). Production needs an approved SMS/email vendor.
OTP_PROVIDER=mock
